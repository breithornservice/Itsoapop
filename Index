<script>
/* =========================================================================
   CONFIGURAZIONE — compila qui e il sito diventa operativo.
   1. Shopify Admin → Impostazioni → App e canali di vendita → Sviluppa app
      → crea un'app → Storefront API → spunta unauthenticated_read_product_listings
      e unauthenticated_write_checkouts → installa → copia il token pubblico.
   2. Per ogni variante prodotto copia l'ID nel formato
      "gid://shopify/ProductVariant/1234567890".
   3. newsletterEndpoint: URL di Formspree, Mailchimp, Klaviyo o simili
      (riceve un POST JSON con {email, lang}). Lascia vuoto per disattivarlo.
   Finché i campi restano vuoti il sito funziona in modalità demo.
   ========================================================================= */
const CONFIG = {
  shopifyDomain: "",            // es. "itsoapop.myshopify.com"
  storefrontToken: "",          // token pubblico Storefront API
  apiVersion: "2026-07",
  currency: "EUR",
  freeShipFrom: 35,
  variants: {
    "blanc-box": "",  "blanc-refill": "",
    "figue-box": "",  "figue-refill": "",
    "neroli-box": "", "neroli-refill": "",
    "santal-box": "", "santal-refill": "",
    "iris-box": "",   "iris-refill": "",
    "rose-box": "",   "rose-refill": "",
    "set": ""
  },
  newsletterEndpoint: ""
};

const IMG={};
document.querySelectorAll("#assets img").forEach(i=>{IMG[i.dataset.k]=i.getAttribute("src");});
IMG.set=document.getElementById("boxImg").getAttribute("src");

const F=[
 {id:"blanc",n:"Blanc",bg:"#FFF2E1",tint:"#FFF2E1",notes:{it:["Tè bianco","Cotone","Muschio"],en:["White tea","Cotton","Musk"]}},
 {id:"figue",n:"Figue",bg:"#CFE3D6",tint:"#CFE3D6",notes:{it:["Foglia di fico","Fico verde","Cedro"],en:["Fig leaf","Green fig","Cedarwood"]}},
 {id:"neroli",n:"Néroli",bg:"#FFD6E2",tint:"#FFD6E2",notes:{it:["Neroli","Bergamotto","Fiori d'arancio"],en:["Neroli","Bergamot","Orange blossom"]}},
 {id:"santal",n:"Santal",bg:"#EBA08C",tint:"#EBA08C",notes:{it:["Sandalo","Ambra","Muschio morbido"],en:["Sandalwood","Amber","Soft musk"]}},
 {id:"iris",n:"Iris",bg:"#DCC6F2",tint:"#DCC6F2",notes:{it:["Iris","Violetta","Muschio cipriato"],en:["Iris","Violet","Powdery musk"]}},
 {id:"rose",n:"Rose",bg:"#FF7BAC",tint:"#FFD6E2",notes:{it:["Rosa","Peonia","Muschio bianco"],en:["Rose","Peony","White musk"]}}
];
/* prezzi di partenza: se Shopify è collegato vengono sovrascritti da quelli veri */
const PRICE={box:7.90,refill:4.90,set:39.90};
const LIVE={};                     // {chiave: {price, available}}
let lang="it", sel=2, variant="box", cart=[];

const $=s=>document.querySelector(s);
const live=()=>!!(CONFIG.shopifyDomain&&CONFIG.storefrontToken);
const t=(it,en)=>lang==="it"?it:en;
const keyOf=(fid,v)=>fid+"-"+v;
const priceOf=k=>LIVE[k]?LIVE[k].price:(k==="set"?PRICE.set:(k.endsWith("refill")?PRICE.refill:PRICE.box));
const availOf=k=>LIVE[k]?LIVE[k].available:true;
const money=v=>new Intl.NumberFormat(lang==="it"?"it-IT":"en-GB",{style:"currency",currency:CONFIG.currency}).format(v);

/* ---------- descrizione riga carrello (ricostruita, così segue la lingua) ---------- */
function itemOf(k){
  if(k==="set") return {name:t("Set completo","Full set"),sub:t("6 pod · 300 foglietti","6 pods · 300 sheets"),img:IMG.set};
  const [fid,v]=k.split("-");
  const f=F.find(x=>x.id===fid)||F[0];
  return {name:f.n,
          sub:v==="refill"?t("Refill · 50 foglietti","Refill · 50 sheets"):t("Pod · 50 foglietti","Pod · 50 sheets"),
          img:IMG[f.id]};
}

/* ---------- memoria del carrello ---------- */
const STORE="itsoapop-cart-v1";
function save(){try{localStorage.setItem(STORE,JSON.stringify(cart.map(l=>({k:l.key,q:l.q}))));}catch(e){}}
function load(){
  try{
    const r=localStorage.getItem(STORE);
    if(r) cart=(JSON.parse(r)||[]).filter(l=>l&&l.k&&l.q>0).map(l=>({key:l.k,q:l.q}));
  }catch(e){cart=[];}
}

/* ---------- Storefront API ---------- */
async function sf(query,variables){
  const r=await fetch(`https://${CONFIG.shopifyDomain}/api/${CONFIG.apiVersion}/graphql.json`,{
    method:"POST",
    headers:{"Content-Type":"application/json","X-Shopify-Storefront-Access-Token":CONFIG.storefrontToken},
    body:JSON.stringify({query,variables})
  });
  if(!r.ok) throw new Error("HTTP "+r.status);
  const j=await r.json();
  if(j.errors&&j.errors.length) throw new Error(j.errors[0].message);
  return j.data;
}
async function syncCatalog(){
  if(!live()) return;
  const map=Object.entries(CONFIG.variants).filter(([,v])=>v);
  if(!map.length) return;
  try{
    const d=await sf(`query($ids:[ID!]!){nodes(ids:$ids){... on ProductVariant{id availableForSale price{amount currencyCode}}}}`,
      {ids:map.map(([,v])=>v)});
    (d.nodes||[]).forEach(n=>{
      if(!n) return;
      const hit=map.find(([,v])=>v===n.id);
      if(!hit) return;
      LIVE[hit[0]]={price:parseFloat(n.price.amount),available:n.availableForSale};
      if(n.price.currencyCode) CONFIG.currency=n.price.currencyCode;
    });
    select(sel);renderCart();
  }catch(e){console.warn("Catalogo Shopify non raggiungibile:",e.message);}
}

/* ---------- ticker ---------- */
const claims=[["Delicato sulla pelle","Gentle on skin"],["Poca schiuma","Low foaming"],["Compatto e leggero","Compact & light"],["TSA friendly","TSA friendly"],["Eco friendly","Eco friendly"],["Zero disastri","No mess"],["Refillable","Refillable"],["Plastic-free","Plastic-free"],["Cruelty free","Cruelty free"]];
function buildTicker(){const one=claims.map(c=>`<span>${t(c[0],c[1])}</span>`).join("");$("#tick").innerHTML=one+one;}

/* ---------- fragranze ---------- */
function buildSwatches(){
  $("#swatches").innerHTML=F.map((f,i)=>
    `<button type="button" class="sw" data-i="${i}" aria-pressed="${i===sel}"><img src="${IMG[f.id]}" alt="" style="background:${f.bg}"><span>${f.n}</span></button>`).join("");
  document.querySelectorAll(".sw").forEach(b=>b.addEventListener("click",()=>select(+b.dataset.i)));
}
function select(i){
  sel=i;const f=F[i];const stage=$("#stage");
  stage.classList.add("swap");
  setTimeout(()=>{$("#stageImg").src=IMG[f.id];$("#stageImg").alt=t("Pod ITSOAPOP ","ITSOAPOP pod ")+f.n;stage.classList.remove("swap");},220);
  $("#shop").style.setProperty("--tint",f.tint);
  stage.style.setProperty("--sbg",f.bg);
  $("#fName").textContent=f.n;
  $("#fNum").textContent=String(i+1).padStart(2,"0")+" / 06";
  $("#fNotes").innerHTML=f.notes[lang].map(n=>`<li>${n}</li>`).join("");
  document.querySelectorAll(".sw").forEach(b=>b.setAttribute("aria-pressed",+b.dataset.i===i));
  $("#vBox").querySelector("small").textContent=t("50 foglietti · ","50 sheets · ")+money(priceOf(keyOf(f.id,"box")));
  $("#vRef").querySelector("small").textContent=t("50 foglietti · ","50 sheets · ")+money(priceOf(keyOf(f.id,"refill")));
  renderPrice();
}
function renderPrice(){
  const k=keyOf(F[sel].id,variant), ok=availOf(k);
  $("#fPrice").textContent=money(priceOf(k));
  const b=$("#addBtn");
  b.disabled=!ok;
  b.textContent=ok?t("Aggiungi al beauty","Add to bag"):t("Esaurito","Sold out");
}
$("#vBox").addEventListener("click",()=>{variant="box";$("#vBox").setAttribute("aria-pressed","true");$("#vRef").setAttribute("aria-pressed","false");renderPrice();});
$("#vRef").addEventListener("click",()=>{variant="refill";$("#vRef").setAttribute("aria-pressed","true");$("#vBox").setAttribute("aria-pressed","false");renderPrice();});

/* ---------- carrello ---------- */
function add(key){
  const ex=cart.find(l=>l.key===key);
  if(ex){ex.q++;}else{cart.push({key,q:1});}
  save();renderCart();openCart();toast(t("Aggiunto al beauty","Added to your bag"));
}
$("#addBtn").addEventListener("click",()=>add(keyOf(F[sel].id,variant)));
$("#addSet").addEventListener("click",()=>add("set"));

function renderCart(){
  const box=$("#lines");
  if(!cart.length){
    box.innerHTML=`<p class="empty">${t("Il beauty è vuoto. Scegli una fragranza per iniziare.","Your bag is empty. Pick a fragrance to start.")}</p>`;
  }else{
    box.innerHTML=cart.map((l,i)=>{const it=itemOf(l.key);return `<div class="line">
      <img src="${it.img}" alt="">
      <div><b>${it.name}</b><small>${it.sub}</small>
        <div class="qty">
          <button type="button" data-d="-1" data-i="${i}" aria-label="${t("Togli uno","Remove one")}">−</button>
          <span>${l.q}</span>
          <button type="button" data-d="1" data-i="${i}" aria-label="${t("Aggiungi uno","Add one")}">+</button>
        </div>
        <button type="button" class="rm" data-rm="${i}">${t("Rimuovi","Remove")}</button>
      </div>
      <div>${money(priceOf(l.key)*l.q)}</div></div>`;}).join("");
    box.querySelectorAll(".qty button").forEach(b=>b.addEventListener("click",()=>{
      const i=+b.dataset.i;cart[i].q+=+b.dataset.d;if(cart[i].q<1)cart.splice(i,1);save();renderCart();
    }));
    box.querySelectorAll(".rm").forEach(b=>b.addEventListener("click",()=>{cart.splice(+b.dataset.rm,1);save();renderCart();}));
  }
  const tot=cart.reduce((s,l)=>s+priceOf(l.key)*l.q,0);
  $("#tot").textContent=money(tot);
  $("#count").textContent=cart.reduce((s,l)=>s+l.q,0);
  const miss=CONFIG.freeShipFrom-tot;
  $("#shipNote").textContent= miss<=0
    ? t("Spedizione gratuita in Italia inclusa.","Free shipping in Italy included.")
    : t("Aggiungi "+money(miss)+" per la spedizione gratuita in Italia.","Add "+money(miss)+" for free shipping in Italy.");
  $("#demoNote").textContent= live() ? "" : t("Modalità demo: collega Shopify per incassare davvero.","Demo mode: connect Shopify to take real payments.");
}

/* ---------- checkout Shopify ---------- */
async function goCheckout(){
  const st=$("#ckStatus"), btn=$("#checkout");
  st.style.color="";st.textContent="";
  if(!cart.length){st.textContent=t("Aggiungi prima un prodotto.","Add a product first.");return;}
  const missing=cart.filter(l=>!CONFIG.variants[l.key]);
  if(!live()||missing.length){
    st.textContent=t("Modalità demo: manca la configurazione Shopify, quindi il pagamento non parte.",
                     "Demo mode: Shopify isn't configured yet, so checkout can't start.");
    return;
  }
  const label=btn.textContent;
  btn.disabled=true;btn.textContent=t("Attendi…","One moment…");
  try{
    const d=await sf(`mutation($input:CartInput!){cartCreate(input:$input){cart{checkoutUrl} userErrors{message}}}`,{
      input:{
        lines:cart.map(l=>({merchandiseId:CONFIG.variants[l.key],quantity:l.q})),
        attributes:[{key:"lingua",value:lang}],
        buyerIdentity:{countryCode:lang==="it"?"IT":null}
      }
    });
    const errs=d.cartCreate.userErrors;
    if(errs&&errs.length) throw new Error(errs[0].message);
    window.location.href=d.cartCreate.cart.checkoutUrl;
  }catch(e){
    btn.disabled=false;btn.textContent=label;
    st.style.color="#C21361";
    st.textContent=t("Non riusciamo ad aprire il pagamento. Riprova tra poco.","We can't open checkout right now. Please try again shortly.");
    console.error(e);
  }
}
$("#checkout").addEventListener("click",goCheckout);

/* ---------- drawer ---------- */
let lastFocus=null;
function openCart(){
  lastFocus=document.activeElement;
  $("#drawer").classList.add("on");$("#scrim").classList.add("on");
  $("#drawer").setAttribute("aria-hidden","false");
  setTimeout(()=>$("#closeCart").focus(),120);
}
function closeCart(){
  $("#drawer").classList.remove("on");$("#scrim").classList.remove("on");
  $("#drawer").setAttribute("aria-hidden","true");
  if(lastFocus)lastFocus.focus();
}
$("#openCart").addEventListener("click",openCart);
$("#closeCart").addEventListener("click",closeCart);
$("#scrim").addEventListener("click",closeCart);
document.addEventListener("keydown",e=>{
  if(e.key==="Escape"){closeCart();closeMenu();}
  if(e.key==="Tab"&&$("#drawer").classList.contains("on")){
    const f=$("#drawer").querySelectorAll("button:not([disabled]),a,input");
    if(!f.length)return;
    const first=f[0],last=f[f.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
  }
});

/* ---------- menu mobile ---------- */
function closeMenu(){$("#navLinks").classList.remove("open");$("#burger").setAttribute("aria-expanded","false");}
$("#burger").addEventListener("click",()=>{
  const open=$("#navLinks").classList.toggle("open");
  $("#burger").setAttribute("aria-expanded",open);
});
$("#navLinks").addEventListener("click",e=>{if(e.target.tagName==="A")closeMenu();});

/* ---------- newsletter ---------- */
$("#sub").addEventListener("click",async()=>{
  const el=$("#mail"), st=$("#subStatus"), v=el.value.trim();
  st.textContent="";
  if(!/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(v)){st.textContent=t("Inserisci un indirizzo email valido.","Enter a valid email address.");return;}
  if(!CONFIG.newsletterEndpoint){st.textContent=t("Modalità demo: collega il servizio email per raccogliere gli iscritti.","Demo mode: connect your email service to collect sign-ups.");return;}
  const btn=$("#sub"), label=btn.textContent;
  btn.disabled=true;btn.textContent=t("Invio…","Sending…");
  try{
    const r=await fetch(CONFIG.newsletterEndpoint,{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({email:v,lang:lang,source:"itsoapop.com"})});
    if(!r.ok) throw new Error("HTTP "+r.status);
    el.value="";st.textContent=t("Iscritta. Controlla la mail per il codice sconto.","You're in. Check your inbox for the code.");
  }catch(e){
    st.textContent=t("Iscrizione non riuscita. Riprova tra poco.","Sign-up failed. Please try again shortly.");
  }finally{btn.disabled=false;btn.textContent=label;}
});

/* ---------- toast ---------- */
let tid;
function toast(msg){const el=$("#toast");el.textContent=msg;el.classList.add("on");clearTimeout(tid);tid=setTimeout(()=>el.classList.remove("on"),2600);}

/* ---------- lingua ---------- */
function setLang(l){
  lang=l;document.documentElement.lang=l;
  try{localStorage.setItem("itsoapop-lang",l);}catch(e){}
  $("#btIt").setAttribute("aria-pressed",l==="it");
  $("#btEn").setAttribute("aria-pressed",l==="en");
  document.querySelectorAll("[data-it]").forEach(el=>{el.innerHTML=el.getAttribute("data-"+l);});
  document.querySelectorAll("[data-ph-it]").forEach(el=>{el.placeholder=el.getAttribute("data-ph-"+l);});
  buildTicker();select(sel);renderCart();
}
$("#btIt").addEventListener("click",()=>setLang("it"));
$("#btEn").addEventListener("click",()=>setLang("en"));

/* ---------- avvio ---------- */
load();
buildTicker();buildSwatches();
let saved=null;try{saved=localStorage.getItem("itsoapop-lang");}catch(e){}
setLang(saved==="en"?"en":"it");
$("#drawer").setAttribute("aria-hidden","true");
syncCatalog();

</script>
