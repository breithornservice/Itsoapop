        </div>
      </div>
      <div class="hero-shot"><img src="data:image/webp;base64," alt="Pod ITSOAPOP nei cinque colori con foglietti di sapone"></div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track" id="tick"></div>
  </div>

  <section class="love wrap" id="perche">
    <p class="eyebrow" data-it="Perché ci amerai" data-en="Why you'll love it">Perché ci amerai</p>
    <h2 data-it="Sei buoni motivi per dire pop." data-en="Six good reasons to say pop.">Sei buoni motivi per dire pop.</h2>
    <div class="love-grid">
      <div class="love-card" style="--tint2:var(--pink-light)">
        <div class="icon-wrap"><svg class="icon" viewBox="0 0 24 24"><path d="M12 2s7 8 7 13a7 7 0 11-14 0c0-5 7-13 7-13z"/></svg></div>
        <div><h3 data-it="Delicato e nutriente" data-en="Mild &amp; nourishing">Delicato e nutriente</h3><p data-it="Gentile sulla pelle, anche quella più sensibile." data-en="Gentle on skin, even the most sensitive.">Gentile sulla pelle, anche quella più sensibile.</p></div>
