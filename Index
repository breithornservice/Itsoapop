<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ITSOAPOP — Soap in a snap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --pop:#FF7BAC;
  --pop-deep:#E24C86;
  --pink-light:#FFD6E2;
  --lavender:#DCC6F2;
  --mint:#CFE3D6;
  --cream:#FFF2E1;
  --terracotta:#EBA08C;
  --n50:#FDF8F5;
  --n100:#F9F7F6;
  --n300:#E6E1DC;
  --n500:#C7C2BC;
  --ink:#2B211E;
  --ink-soft:#8A7C77;
  --line:rgba(43,33,30,.12);
  --tint:var(--pink-light);
  --r:22px;
  --pad:clamp(20px,5vw,72px);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--n100);color:var(--ink);
  font-family:"Poppins",system-ui,sans-serif;font-size:16px;line-height:1.6;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
a{color:inherit}
h1,h2,h3,.disp{font-family:"Poppins",sans-serif;font-weight:800;margin:0;line-height:1.02;letter-spacing:-.01em}
.eyebrow{font-family:"Poppins",sans-serif;font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--pop);margin:0 0 12px}
.wrap{max-width:1240px;margin:0 auto;padding:0 var(--pad)}
.icon{width:26px;height:26px;stroke:var(--pop);stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* ---------- nav ---------- */
.nav{position:sticky;top:0;z-index:60;background:rgba(253,248,245,.86);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,123,172,.16)}
.nav-in{max-width:1240px;margin:0 auto;padding:14px var(--pad);display:flex;align-items:center;gap:22px;position:relative}
.logo{font-family:"Poppins",sans-serif;font-weight:800;font-size:22px;letter-spacing:-.03em;color:var(--pop);text-decoration:none}
.logo sup{font-size:9px;vertical-align:super;letter-spacing:0}
.nav-links{display:flex;gap:22px;margin-left:auto;font-size:13.5px;font-weight:500}
.nav-links a{text-decoration:none;opacity:.75}
.nav-links a:hover{opacity:1;color:var(--pop)}
.burger{display:none;width:38px;height:38px;border-radius:999px;border:1px solid rgba(255,123,172,.3);place-items:center;color:var(--pop);font-size:17px}
.lang{display:flex;border:1px solid rgba(255,123,172,.35);border-radius:999px;overflow:hidden;margin-left:auto}
.lang button{padding:5px 10px;font-size:11px;font-weight:700;letter-spacing:.08em;color:var(--pop)}
.lang button[aria-pressed="true"]{background:var(--pop);color:#fff}
.cart-btn{display:flex;align-items:center;gap:8px;background:var(--pop);color:#fff;padding:9px 16px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.cart-btn .count{background:#fff;color:var(--pop);border-radius:999px;min-width:19px;height:19px;display:grid;place-items:center;font-size:11px}
.btn[disabled],.variant[disabled]{opacity:.5;cursor:not-allowed}
.status{font-size:13px;margin:14px 0 0;min-height:18px}
.demo-note{font-size:11px;color:var(--ink-soft);margin:10px 0 0;text-align:center}

/* ---------- hero ---------- */
.hero{padding-top:clamp(30px,5vw,58px);padding-bottom:0}
.hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(24px,4vw,56px);align-items:center}
.hero h1{font-weight:800;font-size:clamp(42px,6.6vw,80px);text-transform:uppercase}
.hero h1 em{font-style:normal;color:var(--pop)}
.hero p.lead{font-size:clamp(16px,1.5vw,19px);max-width:36ch;color:var(--ink-soft);margin:20px 0 28px;font-weight:400}
.btn{display:inline-flex;align-items:center;gap:10px;background:var(--pop);color:#fff;padding:15px 26px;border-radius:999px;font-family:"Poppins",sans-serif;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:transform .18s,background .18s}
.btn:hover{background:var(--pop-deep);transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--pop);box-shadow:inset 0 0 0 1.5px var(--pop)}
.btn.ghost:hover{background:var(--pop);color:#fff}
.hero-shot{position:relative;border-radius:28px;overflow:hidden;background:linear-gradient(160deg,var(--cream),var(--pink-light))}
.hero-shot img{width:100%}
.hero-meta{display:flex;gap:26px;margin-top:26px;font-size:12px;color:var(--ink-soft)}
.hero-meta b{display:block;font-family:"Poppins",sans-serif;font-size:19px;color:var(--ink);font-weight:800}

/* ---------- ticker ---------- */
.ticker{margin-top:clamp(32px,5vw,52px);background:var(--pop);color:#fff;overflow:hidden;padding:13px 0}
.ticker-track{display:flex;gap:44px;width:max-content;animation:slide 26s linear infinite}
.ticker span{font-family:"Poppins",sans-serif;font-weight:600;font-size:12px;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;display:flex;align-items:center;gap:44px}
.ticker span::after{content:"";width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.6)}
@keyframes slide{to{transform:translateX(-50%)}}

/* ---------- love-it grid ---------- */
.love{padding-top:clamp(56px,8vw,100px);padding-bottom:clamp(20px,3vw,36px)}
.love h2,.moments h2,.life h2,.faq h2{font-size:clamp(28px,4vw,44px);font-weight:800;text-transform:uppercase}
.love-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2.4vw,26px);margin-top:40px}
.love-card{background:#fff;border-radius:var(--r);padding:26px 22px;display:flex;gap:16px;align-items:flex-start}
.love-card .icon-wrap{flex:0 0 auto;width:46px;height:46px;border-radius:14px;background:var(--tint2,var(--pink-light));display:grid;place-items:center}
.love-card h3{font-size:15.5px;font-weight:700;text-transform:uppercase;margin:0 0 4px;letter-spacing:.01em}
.love-card p{margin:0;font-size:13.5px;color:var(--ink-soft)}

/* ---------- how it works ---------- */
.how{padding:clamp(52px,7vw,88px) 0}
.how-inner{background:#fff;border-radius:calc(var(--r) + 6px);padding:clamp(28px,4vw,52px);text-align:center}
.how h2{font-size:clamp(30px,4.4vw,50px);text-transform:uppercase;color:var(--pop)}
.how-row{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,3vw,36px);margin-top:36px}
.how-step{padding:0 6px}
.how-step .icon-wrap{width:60px;height:60px;border-radius:50%;background:var(--pink-light);display:grid;place-items:center;margin:0 auto 14px}
.how-step h3{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px}
.how-step p{margin:0;font-size:13.5px;color:var(--ink-soft)}

/* ---------- shop ---------- */
.shop{background:var(--tint);transition:background .6s ease;padding:clamp(48px,7vw,88px) 0 clamp(48px,7vw,80px);margin-top:clamp(16px,3vw,32px)}
.shop-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:34px}
.shop-head h2{font-size:clamp(28px,4vw,44px);font-weight:800;text-transform:uppercase}
.shop-head p{margin:8px 0 0;color:var(--ink-soft);font-size:15px;max-width:38ch}
.config{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(20px,3vw,48px);background:#fff;border-radius:calc(var(--r) + 6px);padding:clamp(18px,2.4vw,30px);align-items:center}
.stage{position:relative;border-radius:var(--r);overflow:hidden;background:var(--sbg,#FFD6E2);transition:background .6s ease;display:grid;place-items:center;min-height:320px}
.stage img{height:280px;width:auto;object-fit:contain;transition:opacity .35s ease,transform .5s cubic-bezier(.2,.8,.3,1)}
.stage.swap img{opacity:0;transform:translateY(10px) scale(.97)}
.stage .pill{position:absolute;left:14px;bottom:12px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--pop);background:rgba(255,255,255,.85);padding:6px 12px;border-radius:999px}
.detail .num{font-family:"Poppins",sans-serif;font-weight:700;font-size:12px;letter-spacing:.2em;color:var(--pop)}
.detail h3{font-size:clamp(32px,4.4vw,50px);font-weight:800;text-transform:uppercase;margin:6px 0 14px}
.notes{list-style:none;padding:0;margin:0 0 22px;display:flex;flex-wrap:wrap;gap:8px}
.notes li{font-size:12.5px;letter-spacing:.02em;background:var(--tint);transition:background .6s ease;padding:6px 13px;border-radius:999px;font-weight:500}
.variants{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
.variant{border:1.5px solid var(--line);border-radius:14px;padding:11px 16px;text-align:left;transition:border-color .2s,background .2s}
.variant b{display:block;font-family:"Poppins",sans-serif;font-size:13px;font-weight:700;letter-spacing:.01em}
.variant small{color:var(--ink-soft);font-size:12px}
.variant[aria-pressed="true"]{border-color:var(--pop);background:rgba(255,123,172,.08)}
.buyline{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.price{font-family:"Poppins",sans-serif;font-weight:800;font-size:29px;letter-spacing:-.01em}
.micro{font-size:12px;color:var(--ink-soft);margin:16px 0 0}
.swatches{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:22px}
.sw{border-radius:16px;overflow:hidden;background:#fff;padding:0 0 10px;border:1.5px solid transparent;transition:border-color .2s,transform .2s}
.sw:hover{transform:translateY(-3px)}
.sw[aria-pressed="true"]{border-color:var(--pop)}
.sw img{height:90px;width:100%;object-fit:contain;padding-top:8px}
.sw span{display:block;font-family:"Poppins",sans-serif;font-weight:700;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;padding-top:8px}

/* ---------- bundle ---------- */
.bundle{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,3vw,44px);align-items:center;background:#fff;border-radius:calc(var(--r) + 6px);padding:clamp(20px,3vw,40px);margin-top:clamp(28px,4vw,44px)}
.bundle h3{font-size:clamp(24px,3.2vw,38px);font-weight:800;text-transform:uppercase;margin-bottom:12px}
.bundle p{color:var(--ink-soft);font-size:15px;margin:0 0 22px}
.bundle-img{border-radius:var(--r);overflow:hidden;background:var(--cream)}
.strike{color:var(--ink-soft);text-decoration:line-through;font-size:16px;font-weight:400;margin-left:8px}

/* ---------- moments ---------- */
.moments{padding:clamp(56px,8vw,96px) 0}
.moments-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:34px}
.moment{background:#fff;border-radius:18px;padding:22px 10px;text-align:center}
.moment .icon-wrap{width:44px;height:44px;border-radius:50%;background:var(--n100);display:grid;place-items:center;margin:0 auto 10px}
.moment span{display:block;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}

/* ---------- lifestyle ---------- */
.life{padding:clamp(56px,8vw,100px) 0}
.life-grid{display:grid;grid-template-columns:1.3fr .85fr .85fr .85fr;gap:14px;margin-top:34px}
.life-card{border-radius:var(--r);overflow:hidden;background:#fff;position:relative;min-height:300px}
.life-card img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.life-card .cap{position:absolute;left:0;right:0;bottom:0;padding:16px;background:linear-gradient(0deg,rgba(43,33,30,.55),transparent);color:#fff;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.story{background:#fff;border-radius:calc(var(--r)+6px);padding:clamp(24px,3.4vw,40px);margin-top:22px;display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center}
.story p{margin:0;font-size:15px;color:var(--ink-soft);max-width:56ch}
.story .tag{font-family:"Poppins",sans-serif;font-weight:800;color:var(--pop);font-size:15px;white-space:nowrap}

/* ---------- faq ---------- */
.faq{background:#fff;padding:clamp(52px,7vw,92px) 0}
.faq-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(20px,4vw,60px)}
details{border-bottom:1px solid var(--line);padding:18px 0}
summary{font-family:"Poppins",sans-serif;font-weight:600;font-size:16px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--pop);font-size:22px;line-height:1}
details[open] summary::after{content:"–"}
details p{margin:12px 0 0;color:var(--ink-soft);font-size:14.5px;max-width:62ch;font-weight:400}

/* ---------- newsletter + footer ---------- */
.news{background:var(--pop);color:#fff;padding:clamp(46px,6vw,76px) 0;text-align:center}
.news .script{font-size:14px;opacity:.85;margin:0 0 6px;font-style:italic}
.news h2{font-size:clamp(26px,3.8vw,42px);font-weight:800;text-transform:uppercase}
.news p.sub{opacity:.9;margin:14px auto 26px;max-width:44ch;font-size:15px;font-weight:400}
.news-form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.news input{border:0;border-radius:999px;padding:14px 20px;min-width:270px;font:inherit;font-size:14px}
.news .btn{background:#fff;color:var(--pop)}
.news .btn:hover{background:var(--ink);color:#fff}
footer{background:var(--n100);padding:34px 0;font-size:13px}
.foot{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;align-items:center;color:var(--ink-soft)}
.foot a{text-decoration:none}
.foot a:hover{color:var(--pop)}

/* ---------- cart drawer ---------- */
.scrim{position:fixed;inset:0;background:rgba(43,33,30,.4);opacity:0;pointer-events:none;transition:opacity .3s;z-index:70}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(410px,100%);background:#fff;z-index:80;transform:translateX(102%);transition:transform .38s cubic-bezier(.3,.9,.3,1);display:flex;flex-direction:column}
.drawer.on{transform:none}
.drawer-h{padding:22px var(--pad);display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}
.drawer-h h3{font-size:19px;font-weight:800;text-transform:uppercase}
.drawer-b{flex:1;overflow:auto;padding:8px var(--pad)}
.line{display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
.line img{width:56px;height:56px;object-fit:contain;background:var(--n100);border-radius:12px;padding:4px}
.line b{font-family:"Poppins",sans-serif;font-size:14px;display:block;text-transform:uppercase}
.line small{color:var(--ink-soft);font-size:12px}
.qty{display:flex;align-items:center;gap:10px;margin-top:6px}
.qty button{width:22px;height:22px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-size:14px;line-height:1}
.empty{padding:44px 0;text-align:center;color:var(--ink-soft);font-size:14px}
.drawer-f{padding:20px var(--pad) 26px;border-top:1px solid var(--line)}
.tot{display:flex;justify-content:space-between;font-family:"Poppins",sans-serif;font-weight:800;font-size:19px;margin-bottom:6px}
.ship{font-size:12px;color:var(--ink-soft);margin:0 0 16px}
.drawer-f .btn{width:100%;justify-content:center}
.line .rm{color:var(--ink-soft);font-size:12px;text-decoration:underline;margin-top:6px}
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:12px 22px;border-radius:999px;font-size:13px;opacity:0;pointer-events:none;transition:.3s;z-index:90}
.toast.on{opacity:1;transform:translate(-50%,0)}

@media(max-width:980px){
  .hero-grid,.config,.bundle,.faq-grid,.story{grid-template-columns:1fr}
  .love-grid{grid-template-columns:1fr 1fr}
  .life-grid{grid-template-columns:1fr 1fr}
  .moments-grid{grid-template-columns:repeat(3,1fr)}
  .how-row{grid-template-columns:1fr}
  .swatches{grid-template-columns:repeat(3,1fr)}
  .nav-links{position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;gap:16px;margin:0;padding:18px var(--pad) 24px;font-size:16px;box-shadow:0 20px 40px -24px rgba(43,33,30,.4);opacity:0;transform:translateY(-10px);pointer-events:none;transition:.22s ease}
  .nav-links.open{opacity:1;transform:none;pointer-events:auto}
  .burger{display:grid}
  .stage img{height:230px}
  .stage{min-height:270px}
  .hero-shot{order:-1}
  .story{text-align:left}
}
@media(max-width:560px){
  .life-grid{grid-template-columns:1fr 1fr}
  .love-grid{grid-template-columns:1fr}
  .moments-grid{grid-template-columns:repeat(3,1fr)}
  .cart-btn span.lbl{display:none}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
}
:focus-visible{outline:2.5px solid var(--pop);outline-offset:3px;border-radius:4px}
</style>
</head>
